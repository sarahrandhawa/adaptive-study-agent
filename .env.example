# ── API (FastAPI) ─────────────────────────────────────────────
OPENAI_API_KEY=
CHAT_MODEL=gpt-5-mini
# STUDY_MODEL=gpt-4o-mini

PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Supabase Postgres: use the Session pooler connection string (IPv4).
DATABASE_URL=

# Shared secret between the Streamlit app and this API.
# Required in production (the API refuses to start on Render without it).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SHARED_SECRET=

# Local development only. Must be false (or unset) in production.
ALLOW_DEV_USER=false

# Optional
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# INGEST_CHUNK_SIZE=800
# INGEST_CHUNK_OVERLAP=100
# APP_ENV=production   # forces production safety checks outside Render
