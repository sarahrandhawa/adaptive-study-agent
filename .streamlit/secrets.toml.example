# Copy to .streamlit/secrets.toml (git-ignored) or paste into Streamlit Cloud > App settings > Secrets.

RAG_API_URL = "http://127.0.0.1:8000"   # production: https://<your-service>.onrender.com
API_SHARED_SECRET = ""                  # must match the API's API_SHARED_SECRET

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # production: https://<app>.streamlit.app/oauth2callback
cookie_secret = ""                                      # python -c "import secrets; print(secrets.token_hex(32))"
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
